227.57,6677,556.23,1.8,1,1.8,0},{1,1231.08,6679.81,558.92,1.8,1,1.8,0},{1,1233.08,6682.61,562.86,1.8,1,1.8,0},{1,1233.2,6685.84,567.27,1.8,1,1.8,0},{1,1231.39,6688.61,571.31,1.8,1,1.8,0},{1,1228.02,6691.29,574.17,1.8,1,1.8,0},{1,1223.75,6694.3,575.3,1.8,1,1.8,0},{1,1219.41,6697.5,574.48,1.8,1,1.8,0},{1,1215.84,6700.42,571.87,1.8,1,1.8,0},{1,1213.75,6703.36,567.98,1.8,1,1.8,0},{1,1213.54,6706.62,563.56,1.8,1,1.8,0},{1,1215.26,6709.57,559.49,1.8,1,1.8,0},{1,1218.56,6712.11,556.55,1.8,1,1.8,0},{1,1222.81,6715.19,555.33,1.8,1,1.8,0},{1,1227.17,6717.94,556.05,1.8,1,1.8,0},{1,1230.79,6720.81,558.58,1.8,1,1.8,0},{1,1232.97,6723.73,562.43,1.8,1,1.8,0},{1,1233.27,6726.54,566.84,1.8,1,1.8,0},{1,1231.65,6729.38,570.95,1.8,1,1.8,0},{1,1228.41,6732.55,573.96,1.8,1,1.8,0},{1,1224.19,6735.16,575.28,1.8,1,1.8,0},{1,1219.82,6737.74,574.65,1.8,1,1.8,0},{1,1216.14,6740.96,572.2,1.8,1,1.8,0},{1,1213.39,6744.26,565.31,8,1,8,0},{4,1223.39,6347.6,581.31,35,814.33,1.5,0},{4,1223.39,6347.6,549.31,35,814.33,1.5,0},{4,1239.39,6347.6,575.31,1.5,814.33,12,0},{4,1239.39,6347.6,555.31,1.5,814.33,12,0},{4,1239.39,6353.1,565.31,1.5,803.33,8,0},{4,1207.39,6347.6,565.31,1.5,814.33,32,0},{3,1247.39,5946.43,558.81,0.4,16,0.4,0},{8,1247.39,5953.63,558.81,0.4,2.4,4.4,0},{6,1228.14,5159.73,565.31,84.5,2,73.5,0}}}
