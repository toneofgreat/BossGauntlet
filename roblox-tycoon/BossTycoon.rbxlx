		for _, ex in ipairs({ -31.8, 33.8 }) do
			Util.part({
				Name = "RailPost", Size = Vector3.new(0.9, 4.4, 0.9),
				CFrame = plot:cf(ex, beltTop + 1.2, z),
				Color = "black", Material = "Metal", Parent = m,
			})
